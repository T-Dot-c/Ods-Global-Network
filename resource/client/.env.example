# =============================================================================
# Wanaw – Client (Vite) Environment Variables Example
# =============================================================================
# Copy to `.env.local` for local development, or use `.env.development` /
# `.env.production` as needed:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put server secrets (JWT, DB passwords, Cloudinary secrets) here.
# =============================================================================

# -----------------------------------------------------------------------------
# Server / API
# -----------------------------------------------------------------------------
# Base URL of the backend API (must include /api)
# Local:  http://localhost:5000/api
# Prod:   https://your-api-domain.com/api
VITE_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# Environment flag
# -----------------------------------------------------------------------------
# development | production
VITE_NODE_ENV=development

# -----------------------------------------------------------------------------
# Authentication (Google OAuth – client ID only)
# -----------------------------------------------------------------------------
# Same Google Cloud OAuth client ID used by the frontend Google button
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
