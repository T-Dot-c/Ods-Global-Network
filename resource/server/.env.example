# =============================================================================
# Wanaw - Server Environment Variables Example
# =============================================================================
# Copy this file to `.env` in the `server/` directory and fill in your values:
#   cp .env.example .env
#
# Do NOT commit real secrets. Keep `.env` private.
# Frontend Vite variables belong in `client/.env` (see Frontend section below).
# =============================================================================

# -----------------------------------------------------------------------------
# Server / API
# -----------------------------------------------------------------------------
# Node environment: development | production
NODE_ENV=development
# HTTP port the Express API listens on (default 5000)
PORT=5000
# Public base URL of this API (used for image URLs, callbacks, etc.)
# Local:  http://localhost:5000
# Prod:   https://your-api-domain.com
BASE_URL=http://localhost:5000
# Public URL of the frontend app (payment return URLs, OAuth redirects, etc.)
# Local:  http://localhost:5173
# Prod:   https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user_here
DB_PASSWORD=your_database_password_here
DB_NAME=your_database_name_here

# -----------------------------------------------------------------------------
# Authentication / Sessions
# -----------------------------------------------------------------------------
# Strong random secret used to sign JWTs (required for login / protected routes)
JWT_SECRET=your_jwt_secret_here
# Strong random secret for express-session
SESSION_SECRET=your_session_secret_here

# Google OAuth (Passport) - server-side credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# -----------------------------------------------------------------------------
# Email configuration
# -----------------------------------------------------------------------------
# Gmail (or compatible) account used by Nodemailer
EMAIL_USER=your_email_address_here
# App password (not your normal account password) for the mail account
EMAIL_PASS=your_email_app_password_here
# Optional: mailer service name if your stack expects it (e.g. gmail)
EMAIL_SERVICE=gmail
# Optional: comma-separated admin emails for new service-request alerts
ADMIN_NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com

# -----------------------------------------------------------------------------
# File uploads / storage (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# -----------------------------------------------------------------------------
# Third-party services - Payments (Chapa)
# -----------------------------------------------------------------------------
CHAPA_SECRET_KEY=your_chapa_secret_key_here
# Present in some deployments; secret key is what the server uses for API calls
CHAPA_PUBLIC_KEY=your_chapa_public_key_here

# -----------------------------------------------------------------------------
# Third-party services - SMS / WhatsApp (Twilio)  [optional]
# -----------------------------------------------------------------------------
# Required only if you want SMS / WhatsApp notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000
# Must start with "whatsapp:" e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000

# -----------------------------------------------------------------------------
# Third-party services - Telegram  [optional]
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# -----------------------------------------------------------------------------
# Third-party services - OpenAI / Chat  [optional]
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional system prompt for the chat assistant
SYSTEM_PROMPT=You are a helpful, concise assistant.

# -----------------------------------------------------------------------------
# Legacy / optional
# -----------------------------------------------------------------------------
# MongoDB connection string (legacy; primary app data uses MySQL above)
MONGO_URI=mongodb+srv://your_mongo_user:your_mongo_password@your_cluster.example.mongodb.net/your_db_name
# Optional admin utility key if used by your deployment tooling
ADMIN_KEY=your_admin_key_here

# =============================================================================
# Frontend variables (Vite) - place these in client/.env or client/.env.local
# =============================================================================
# Do not put VITE_* values in server/.env; Vite only loads env files from client/.
#
# VITE_API_URL=http://localhost:5000/api
# VITE_NODE_ENV=development
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
#
# Production example (client/.env.production):
# VITE_API_URL=https://your-api-domain.com/api
# VITE_NODE_ENV=production
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here