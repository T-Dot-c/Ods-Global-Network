# ODS Global Network — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# ── Server ────────────────────────────────────────
PORT=3001
NODE_ENV=development
TRUST_PROXY=false             # Set to true or 1 when running behind reverse proxy (e.g. Nginx, Cloudflare)

# ── Application Database (Least-Privilege: ods_app) ─
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ods_global.net
DB_USER=ods_app
DB_PASSWORD=your_limited_app_password_here

# ── Test & Migration Database (Owner/Superuser for migrations and test teardown) ─
TEST_ADMIN_DB_HOST=localhost
TEST_ADMIN_DB_PORT=5432
TEST_ADMIN_DB_NAME=ods_global.net
TEST_ADMIN_DB_USER=postgres
TEST_ADMIN_DB_PASSWORD=your_postgres_password_here

# ── Testing Flags & Dev Credentials ─────────────────
# Safety flag required by test suites (e.g. test-batch4-endpoints.js) before executing teardown.
# Run directly via CLI:  ALLOW_DESTRUCTIVE_TESTS=1 node test-batch4-endpoints.js
# Or in PowerShell:      $env:ALLOW_DESTRUCTIVE_TESTS="1"; node test-batch4-endpoints.js
# Or set via npm script: "test:b4": "cross-env ALLOW_DESTRUCTIVE_TESTS=1 node test-batch4-endpoints.js"
# ALLOW_DESTRUCTIVE_TESTS=1
DEV_PASSWORD=your_dev_testing_password_here
ADMIN_PASSWORD=your_strong_admin_password_min_8_chars

# ── JWT & Token Secrets (minimum 32 random characters) ─
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
STAGING_TOKEN_SECRET=replace_with_dedicated_staging_secret_min_32_chars

# ── Cookie Config ──────────────────────────────────
COOKIE_SECURE=false         # Set to true in production (requires HTTPS)
COOKIE_MAX_AGE_MS=86400000  # 1 day in milliseconds

# ── Frontend Origin (for CORS) ─────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Rate Limiting (Production defaults shown; automated test suites require dev/test overrides) ─
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000   # 15 minutes in ms (default: 15 min)
# RATE_LIMIT_GLOBAL_MAX=100           # 100 requests per window (default: 100)
# RATE_LIMIT_AUTH_WINDOW_MS=900000     # 15 minutes in ms (default: 15 min)
# RATE_LIMIT_AUTH_MAX=20              # 20 auth requests per window (default: 20)
# RATE_LIMIT_CUSTOMER_MAX=1000        # Generous customer action limit
# RATE_LIMIT_ANON_WINDOW_MS=900000     # 15 minutes in ms (default: 15 min)
# RATE_LIMIT_ANON_MAX=10              # 10 anonymous uploads per window (default: 10)
# Batch 5 Specific Rate Limits (placeholders):
# RATE_LIMIT_FORGOT_IP_MAX=1000
# RATE_LIMIT_FORGOT_EMAIL_MAX=1000
# RATE_LIMIT_RESET_IP_MAX=1000
# RATE_LIMIT_REGISTER_IP_MAX=1000
# RATE_LIMIT_REGISTER_EMAIL_MAX=1000
# RATE_LIMIT_RESEND_IP_MAX=1000
# RATE_LIMIT_CHANGE_PASSWORD_MAX=1000

# ── SMTP & Transactional Email (Batch 5) ─────────────
# Local development default uses Mailpit (127.0.0.1:1025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ODS Global Network <no-reply@ods-global.net>"

# ── Payment Gateway & Chapa Integration (Batch 6) ────
# Official free Chapa Sandbox keys or 'mock' for self-contained offline simulator
CHAPA_API_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=CHASECK_TEST-sample-key
CHAPA_WEBHOOK_SECRET=ods-test-webhook-secret
CHAPA_SIMULATOR_MODE=true
