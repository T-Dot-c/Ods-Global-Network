# ODS Global Network — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# ── Server ────────────────────────────────────────
PORT=3001
NODE_ENV=development
TRUST_PROXY=false             # Set to true or 1 when running behind reverse proxy (e.g. Nginx, Cloudflare)

# ── Application Database (Least-Privilege: ods_app) ─
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ods_global.net
DB_USER=ods_app
DB_PASSWORD=your_limited_app_password_here

# ── Test & Migration Database (Owner/Superuser for migrations and test teardown) ─
TEST_ADMIN_DB_HOST=localhost
TEST_ADMIN_DB_PORT=5432
TEST_ADMIN_DB_NAME=ods_global.net
TEST_ADMIN_DB_USER=postgres
TEST_ADMIN_DB_PASSWORD=your_postgres_password_here

# ── Initial Admin Seed Password (pre-migrate-create-admin.js) ─
ADMIN_PASSWORD=your_strong_admin_password_min_8_chars

# ── JWT & Token Secrets (minimum 32 random characters) ─
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
STAGING_TOKEN_SECRET=replace_with_dedicated_staging_secret_min_32_chars

# ── Cookie Config ──────────────────────────────────
COOKIE_SECURE=false         # Set to true in production (requires HTTPS)
COOKIE_MAX_AGE_MS=86400000  # 1 day in milliseconds

# ── Frontend Origin (for CORS) ─────────────────────
FRONTEND_ORIGIN=http://localhost:5173
